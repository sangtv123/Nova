{
  "name": "@nova/motion",
  "version": "0.0.1",
  "description": "Signal-driven high-performance GPU-accelerated motion engine for Nova",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["motion", "animation", "signals", "reactivity", "nova"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@nova/signals": "file:../signals",
    "@nova/runtime": "file:../runtime"
  }
}
