{
  "name": "@nova/cli",
  "version": "0.0.1",
  "description": "Nova CLI for project scaffolding and development",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "nova": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nova/server": "file:../server",
    "@nova/builder": "file:../builder",
    "@nova/compiler": "file:../compiler"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "sass-embedded": "^1.70.0",
    "typescript": "^5.3.0"
  }
}
