{
  "name": "@nova/http",
  "version": "0.0.1",
  "description": "Reactive HTTP client for Nova — interceptors, retry, caching, cancellation, and signal integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["http", "fetch", "client", "nova", "signals", "reactive"],
  "license": "MIT",
  "peerDependencies": {
    "@nova/signals": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
